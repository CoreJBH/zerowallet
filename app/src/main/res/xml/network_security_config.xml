<?xml version="1.0" encoding="utf-8"?>
<!--
    Cleartext stays off for the internet, and is allowed only for a node on this phone.

    The wallet talks https to every Esplora and price endpoint. The one plain-http case is a
    personal Esplora instance or a local proxy bound to loopback (127.0.0.0/8, localhost),
    where the traffic never leaves the device. `usesCleartextTraffic="false"` stays set on
    the application; these domain rules are the only exception it makes, and they cover no
    name that resolves off the device.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
